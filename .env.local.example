# =============================================================================
# LOCAL production stack — ready to run, nothing to fill in.
#
#   cp .env.local.example .env
#   docker compose up -d
#   cd backend && uv run alembic upgrade head
#
# This is the full production architecture bound to local infrastructure. Every
# service here is the same one production uses; only the endpoints differ.
#
# Every vendor is a FAKE and DRY_RUN is on. Nothing in this file can spend
# money, call a customer, or send an email to a real inbox. Turning any of that
# on is a deliberate, separate act — see docs/LOCAL_PRODUCTION_SETUP.md.
#
# NEVER commit the .env you make from this.
# =============================================================================

# ---- Application ---------------------------------------------------------
APP_NAME="AI Receptionist API"
ENVIRONMENT=local
DEBUG=true

# ---- Safety --------------------------------------------------------------
# The master switch. While true, Twilio, ElevenLabs, email, Stripe and object
# storage all resolve to their fake implementations no matter what the
# *_PROVIDER settings below say. A local stack cannot bill you.
DRY_RUN=true

# ---- HTTP ----------------------------------------------------------------
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
CORRELATION_ID_HEADER=X-Correlation-ID

# ---- Logging -------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console

# ---- PostgreSQL — the source of truth ------------------------------------
DATABASE_URL=postgresql+asyncpg://receptionist:receptionist@localhost:55432/receptionist
POSTGRES_USER=receptionist
POSTGRES_PASSWORD=receptionist
POSTGRES_DB=receptionist
POSTGRES_PORT=55432

# ---- Redis — cache only, never authoritative -----------------------------
REDIS_URL=redis://localhost:56379/0
REDIS_ENABLED=true
REDIS_PORT=56379

# ---- Temporal — orchestration --------------------------------------------
# Temporal is authoritative (M4). The polling worker no longer claims
# provisioning runs; run it with `python -m app.temporal.worker`.
# `state_machine` is a documented fallback, not an equal path.
ORCHESTRATOR=temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=ai-receptionist
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233

# ---- Object storage — MinIO ----------------------------------------------
OBJECT_STORAGE_PROVIDER=fake
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ai-receptionist
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_PATH_STYLE=true
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Email — Mailpit -----------------------------------------------------
# Mailpit accepts every message and delivers none. Read them at
# http://localhost:8025. EMAIL_PROVIDER=smtp only takes effect once DRY_RUN is
# off; until then the fake provider records sends in memory.
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USE_TLS=false
EMAIL_FROM="AI Receptionist <onboarding@localhost>"
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---- Providers — all fake ------------------------------------------------
LLM_PROVIDER=fake
TWILIO_PROVIDER=fake
ELEVENLABS_PROVIDER=fake
PAYMENT_PROVIDER=fake
PROVIDER_TIMEOUT_S=30

# ---- Billing -------------------------------------------------------------
# On even locally. The gate is the difference between a bug that wastes a test
# run and a bug that buys phone numbers, so local is exactly where it should be
# exercised rather than switched off.
BILLING_GATE_ENABLED=true
TRIAL_DAYS=14
TRIAL_INCLUDED_MINUTES=60
BILLING_RECHECK_INTERVAL_S=300
STRIPE_PRICE_PLANS=

# ---- Authentication ------------------------------------------------------
# Local-only placeholder. Generate a real one for anything shared:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=local-development-only-not-a-secret-000000
# false because local development is plain HTTP; a Secure cookie would never
# be sent and every login would silently fail to stick.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# ---- Admin ---------------------------------------------------------------
ADMIN_API_KEY=local-admin-key

# ---- Observability -------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLE_RATIO=1.0

# ---- Worker --------------------------------------------------------------
WORKER_POLL_INTERVAL_S=2
WORKER_BATCH_SIZE=5
PROVISIONING_MAX_ATTEMPTS=5
PROVISIONING_BACKOFF_S=5,30,120,600
PROVISIONING_STEP_TIMEOUT_S=300
CALL_SUMMARY_MAX_ATTEMPTS=3

# ---- Signup --------------------------------------------------------------
SIGNUP_RATE_LIMIT=10
SIGNUP_RATE_LIMIT_WINDOW_S=60

# ---- Public URLs ---------------------------------------------------------
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
API_PORT=8000
FRONTEND_PORT=3000

# ---- Telephony: the production call path (M6) ----------------------------
# elevenlabs_native -- the POC path. The number is imported into ElevenLabs and
#                      the vendor owns routing end to end. Simple, but we see
#                      nothing until the post-call webhook and have no fallback.
# twiml_stream      -- the production path. Twilio posts to /voice/inbound, we
#                      decide, and we hand the media stream to the vendor. We
#                      own routing, we can answer with a voicemail when the
#                      vendor is down, and every call is recorded on arrival.
# Defaults to the POC path so existing tenants are unaffected until migrated.
CALL_PATH=elevenlabs_native
ELEVENLABS_STREAM_URL=wss://api.elevenlabs.io/v1/convai/conversation
TWILIO_FALLBACK_VOICE=Polly.Joanna
VOICEMAIL_MAX_LENGTH_S=120
# Recording consent is jurisdictional. Where it is required this must be on;
# the announcement is injected into the greeting rather than left to the prompt.
RECORDING_CONSENT_ANNOUNCEMENT=false

# ---- Shared vertical agents (M7) -----------------------------------------
# "salon:agent_a,legal:agent_b,generic:agent_z". Configured, never discovered:
# agent ids are account-specific, exactly like Stripe price ids. Nothing in the
# application creates a shared agent -- two agents serving one vertical is a
# split-brain where half the customers get a stale prompt.
# Leave blank to keep every tenant on its own dedicated agent.
SHARED_AGENT_IDS=

# ---- Webhook security (M9) -----------------------------------------------
# Production-like environments always require a valid signature; this can only
# raise the bar in local and test, never lower it in staging or production.
# A signature that is *present and wrong* is refused everywhere regardless.
REQUIRE_WEBHOOK_SIGNATURE=false
# How old a signed delivery may be before it is refused as a replay.
WEBHOOK_TOLERANCE_S=1800

# ---- Vendor circuit breakers (M17) ---------------------------------------
# Consecutive failures before a vendor is treated as down, and how long the
# circuit stays open before one probe is allowed through. Per process on
# purpose: a shared breaker would let a cache outage open every circuit at once.
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_S=30

# ---- Background maintenance (M11, M12) -----------------------------------
# How often the worker runs the retention sweep and rebuilds usage rollups.
# Both are idempotent catch-up jobs, so a missed tick costs nothing.
MAINTENANCE_INTERVAL_S=3600
