# =============================================================================
# TEST environment — CI and the local test suite.
#
#   cp .env.test.example .env.test
#
# The suite does not read this file by default. Tests construct Settings
# explicitly (tests/support.py) precisely so that a developer's environment
# cannot change what the suite proves. This file exists for the two things
# that *are* environmental: which PostgreSQL to use, and which Redis.
#
# Contract, enforced by DRY_RUN and by the fakes rather than by convention:
#   - no test purchases a phone number
#   - no test sends an email
#   - no test charges a card
#   - no test requires network access
# =============================================================================

ENVIRONMENT=test
DEBUG=false
DRY_RUN=true
LOG_LEVEL=WARNING
LOG_FORMAT=json

# ---- Database ------------------------------------------------------------
# The scratch database the suite DROPS and recreates once per session, then
# migrates with `alembic upgrade head`. Never point this at a database whose
# contents you want to keep.
#
# Created on first boot by infra/postgres/init/01-databases.sql.
TEST_DATABASE_URL=postgresql+asyncpg://receptionist:receptionist@localhost:55432/receptionist_test
DATABASE_URL=postgresql+asyncpg://receptionist:receptionist@localhost:55432/receptionist_test

# ---- Redis ---------------------------------------------------------------
# Database 15, so a flush during a test run cannot clear a developer's local
# cache on database 0.
REDIS_URL=redis://localhost:56379/15
REDIS_ENABLED=false

# ---- Temporal ------------------------------------------------------------
# Workflow tests use Temporal's in-process time-skipping test environment, not
# this address. It is here for the small number of tests that exercise the real
# client, which skip when nothing is listening.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=ai-receptionist-test
ORCHESTRATOR=state_machine

# ---- Providers — fake, always --------------------------------------------
# CI has no vendor credentials and must never need any. A test that cannot run
# against a fake is testing the vendor, not us, and belongs in the explicit
# integration-test command instead.
LLM_PROVIDER=fake
TWILIO_PROVIDER=fake
ELEVENLABS_PROVIDER=fake
EMAIL_PROVIDER=fake
PAYMENT_PROVIDER=fake
OBJECT_STORAGE_PROVIDER=fake

# ---- Secrets — deterministic placeholders --------------------------------
# Fixed values so signature and session assertions are reproducible. None of
# these is, or has ever been, a real credential.
AUTH_SECRET_KEY=test-auth-secret-key-not-used-anywhere-real
ADMIN_API_KEY=test-admin-key
ELEVENLABS_WEBHOOK_SECRET=test-webhook-secret
STRIPE_WEBHOOK_SECRET=whsec_test
TALLY_SIGNING_SECRET=test-tally-secret
SESSION_COOKIE_SECURE=false

# ---- Off in tests --------------------------------------------------------
OTEL_ENABLED=false
BILLING_GATE_ENABLED=true
