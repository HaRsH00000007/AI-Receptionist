# =============================================================================
# TEST environment — CI and the local test suite.
#
#   cp .env.test.example .env.test
#
# The suite does not read this file by default. Tests construct Settings
# explicitly (tests/support.py) precisely so that a developer's environment
# cannot change what the suite proves. This file exists for the two things
# that *are* environmental: which PostgreSQL to use, and which Redis.
#
# Contract, enforced by DRY_RUN and by the fakes rather than by convention:
#   - no test purchases a phone number
#   - no test sends an email
#   - no test charges a card
#   - no test requires network access
# =============================================================================

ENVIRONMENT=test
DEBUG=false
DRY_RUN=true
LOG_LEVEL=WARNING
LOG_FORMAT=json

# ---- Database ------------------------------------------------------------
# The scratch database the suite DROPS and recreates once per session, then
# migrates with `alembic upgrade head`. Never point this at a database whose
# contents you want to keep.
#
# Created on first boot by infra/postgres/init/01-databases.sql.
TEST_DATABASE_URL=postgresql+asyncpg://receptionist:receptionist@localhost:55432/receptionist_test
DATABASE_URL=postgresql+asyncpg://receptionist:receptionist@localhost:55432/receptionist_test

# ---- Redis ---------------------------------------------------------------
# Database 15, so a flush during a test run cannot clear a developer's local
# cache on database 0.
REDIS_URL=redis://localhost:56379/15
REDIS_ENABLED=false

# ---- Temporal ------------------------------------------------------------
# Workflow tests use Temporal's in-process time-skipping test environment, not
# this address. It is here for the small number of tests that exercise the real
# client, which skip when nothing is listening.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=ai-receptionist-test
ORCHESTRATOR=state_machine

# ---- Providers — fake, always --------------------------------------------
# CI has no vendor credentials and must never need any. A test that cannot run
# against a fake is testing the vendor, not us, and belongs in the explicit
# integration-test command instead.
LLM_PROVIDER=fake
TWILIO_PROVIDER=fake
ELEVENLABS_PROVIDER=fake
EMAIL_PROVIDER=fake
PAYMENT_PROVIDER=fake
OBJECT_STORAGE_PROVIDER=fake

# ---- Secrets — deterministic placeholders --------------------------------
# Fixed values so signature and session assertions are reproducible. None of
# these is, or has ever been, a real credential.
AUTH_SECRET_KEY=test-auth-secret-key-not-used-anywhere-real
ADMIN_API_KEY=test-admin-key
ELEVENLABS_WEBHOOK_SECRET=test-webhook-secret
STRIPE_WEBHOOK_SECRET=whsec_test
TALLY_SIGNING_SECRET=test-tally-secret
SESSION_COOKIE_SECURE=false

# ---- Off in tests --------------------------------------------------------
OTEL_ENABLED=false
BILLING_GATE_ENABLED=true

# ---- Telephony: the production call path (M6) ----------------------------
# elevenlabs_native -- the POC path. The number is imported into ElevenLabs and
#                      the vendor owns routing end to end. Simple, but we see
#                      nothing until the post-call webhook and have no fallback.
# twiml_stream      -- the production path. Twilio posts to /voice/inbound, we
#                      decide, and we hand the media stream to the vendor. We
#                      own routing, we can answer with a voicemail when the
#                      vendor is down, and every call is recorded on arrival.
# Defaults to the POC path so existing tenants are unaffected until migrated.
CALL_PATH=elevenlabs_native
ELEVENLABS_STREAM_URL=wss://api.elevenlabs.io/v1/convai/conversation
TWILIO_FALLBACK_VOICE=Polly.Joanna
VOICEMAIL_MAX_LENGTH_S=120
# Recording consent is jurisdictional. Where it is required this must be on;
# the announcement is injected into the greeting rather than left to the prompt.
RECORDING_CONSENT_ANNOUNCEMENT=false

# ---- Shared vertical agents (M7) -----------------------------------------
# "salon:agent_a,legal:agent_b,generic:agent_z". Configured, never discovered:
# agent ids are account-specific, exactly like Stripe price ids. Nothing in the
# application creates a shared agent -- two agents serving one vertical is a
# split-brain where half the customers get a stale prompt.
# Leave blank to keep every tenant on its own dedicated agent.
SHARED_AGENT_IDS=

# ---- Webhook security (M9) -----------------------------------------------
# Production-like environments always require a valid signature; this can only
# raise the bar in local and test, never lower it in staging or production.
# A signature that is *present and wrong* is refused everywhere regardless.
REQUIRE_WEBHOOK_SIGNATURE=false
# How old a signed delivery may be before it is refused as a replay.
WEBHOOK_TOLERANCE_S=1800

# ---- Vendor circuit breakers (M17) ---------------------------------------
# Consecutive failures before a vendor is treated as down, and how long the
# circuit stays open before one probe is allowed through. Per process on
# purpose: a shared breaker would let a cache outage open every circuit at once.
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_S=30

# ---- Background maintenance (M11, M12) -----------------------------------
# How often the worker runs the retention sweep and rebuilds usage rollups.
# Both are idempotent catch-up jobs, so a missed tick costs nothing.
MAINTENANCE_INTERVAL_S=60
