# =============================================================================
# AWS deployment settings — identifiers, not secrets.
#
# Sourced by deploy.sh (bash syntax: quote values containing spaces). Every
# credential lives in Secrets Manager and is referenced by *key name* in
# secrets.txt; nothing in this directory carries a secret value.
#
# Personal or machine-specific overrides go in deploy.local.env (gitignored),
# which is sourced after this file.
# =============================================================================

# ---- Account -------------------------------------------------------------
AWS_ACCOUNT_ID=235390156588
AWS_REGION=us-east-2
ECR_REPOSITORY=ai-receptionist
ECS_CLUSTER=ai-receptionist
EXECUTION_ROLE_ARN=arn:aws:iam::235390156588:role/ecsTaskExecutionRole
TASK_ROLE_ARN=arn:aws:iam::235390156588:role/ecsTaskExecutionRole
SECRET_ARN=arn:aws:secretsmanager:us-east-2:235390156588:secret:ai-receptionist/production-tbl6mT
LOG_GROUP=/ecs/ai-receptionist

# ---- Network (default VPC; public subnets, no NAT -> tasks need a public IP)
VPC_ID=vpc-0819bb88cacb3ad29
SUBNETS=subnet-0548411e889211846,subnet-0195a5ddabd91aa5f,subnet-082f9596f4fb60841
# The ECS application SG. RDS (sg-09af107377e4d5cee) and ElastiCache admit it.
TASK_SECURITY_GROUP=sg-0d429eaa70b70cadf
ASSIGN_PUBLIC_IP=ENABLED

# ---- Load balancing ------------------------------------------------------
API_TARGET_GROUP_ARN=arn:aws:elasticloadbalancing:us-east-2:235390156588:targetgroup/ai-receptionist-api-tg/901427e368c3487c
WEB_TARGET_GROUP_ARN=arn:aws:elasticloadbalancing:us-east-2:235390156588:targetgroup/ai-receptionist-web-tg/89d58cb0aecff219
CLOUDFRONT_DISTRIBUTION_ID=E2V182IZLBQ0NU

# ---- ECS services --------------------------------------------------------
# The API service predates this directory and kept its generated name.
API_SERVICE=ai-receptionist-service-d78yjjez
WORKER_SERVICE=ai-receptionist-worker
TEMPORAL_WORKER_SERVICE=ai-receptionist-temporal-worker
FRONTEND_SERVICE=ai-receptionist-frontend
# Zero until Temporal Cloud credentials exist and ORCHESTRATOR=temporal.
TEMPORAL_WORKER_COUNT=0

# ---- Public endpoints ----------------------------------------------------
# One origin for both frontend and API (CloudFront -> ALB path routing), so
# session cookies are first-party and CORS has a single allowed origin.
PUBLIC_URL=https://d3e8unss81w8wv.cloudfront.net
REDIS_HOST=ai-receptionist-staging-redis-9kat40.serverless.use2.cache.amazonaws.com

# ---- Application mode ----------------------------------------------------
# development until ELEVENLABS_WEBHOOK_SECRET is in Secrets Manager; then
# production (which also refuses to boot without the other hardening checks).
APP_ENVIRONMENT=development
# false since 2026-10-01: Twilio, ElevenLabs and email are real. Provisioning a
# business now buys a real number and creates a real agent.
DRY_RUN=false
# state_machine until Temporal Cloud credentials exist; then temporal.
ORCHESTRATOR=state_machine
# Placeholder; the real sender is set in deploy.local.env. It must be on a
# domain verified with Resend before DRY_RUN=false.
EMAIL_FROM="AI Receptionist <onboarding@example.com>"
