# Non-secret environment shared by every backend container (API, workers,
# migrations). KEY=VALUE, no quoting; ${NAME} is filled from deploy.env.
# Secrets are NOT listed here — see secrets.txt.
ENVIRONMENT=${APP_ENVIRONMENT}
DEBUG=false
DRY_RUN=${DRY_RUN}
LOG_FORMAT=json
LOG_LEVEL=INFO
CORS_ORIGINS=${PUBLIC_URL}
PUBLIC_APP_URL=${PUBLIC_URL}
PUBLIC_API_URL=${PUBLIC_URL}
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
REDIS_ENABLED=true
REDIS_URL=rediss://${REDIS_HOST}:6379/0
ORCHESTRATOR=${ORCHESTRATOR}
DEFAULT_AGENT_MODE=per_tenant
CALL_PATH=elevenlabs_native
LLM_PROVIDER=groq
LLM_CONFIG_MODEL=llama-3.3-70b-versatile
LLM_SUMMARY_MODEL=llama-3.1-8b-instant
TWILIO_PROVIDER=twilio
ELEVENLABS_PROVIDER=elevenlabs
EMAIL_PROVIDER=resend
EMAIL_FROM=${EMAIL_FROM}
PAYMENT_PROVIDER=fake
BILLING_GATE_ENABLED=true
OBJECT_STORAGE_PROVIDER=fake
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
OTEL_ENABLED=false
