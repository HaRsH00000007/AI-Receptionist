# ---- Secrets -------------------------------------------------------------
# Real values never leave the machine. The *.example templates carry the
# variable names and the reasoning, never a credential.
.env
.env.*
!.env.example
!.env.local.example
!.env.test.example
*.pem
*.key

# ---- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# ---- Node / Next.js ------------------------------------------------------
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo

# ---- Editors / OS --------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- Local data ----------------------------------------------------------
postgres-data/
*.log

# ---- ECS deployment (infra/ecs) ------------------------------------------
# Rendered task definitions are build output; the templates are the source.
infra/ecs/.rendered/
# Personal overrides (e.g. EMAIL_FROM) that should not be in a public repo.
infra/ecs/deploy.local.env
