# =============================================================================
# AI Receptionist — environment template
#
# Copy to `.env` and fill in. NEVER commit `.env`.
#   cp .env.example .env
#
# Only the variables that Module 1 actually reads are listed. Vendor
# credentials (Twilio / ElevenLabs / LLM / email) are added by later modules.
# =============================================================================

# ---- Application ---------------------------------------------------------
APP_NAME="AI Receptionist API"
# local | test | development | staging | production
ENVIRONMENT=local
DEBUG=true

# ---- Safety --------------------------------------------------------------
# When true, no external side effect that costs money or mutates a vendor
# account may be performed. Defaults to true and must be flipped explicitly.
# See docs/00_DECISIONS.md section 7.1 (money leak).
DRY_RUN=true

# ---- HTTP ----------------------------------------------------------------
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
CORRELATION_ID_HEADER=X-Correlation-ID

# ---- Signup --------------------------------------------------------------
# Per-IP signups allowed in the window. Every accepted signup eventually spends
# money on a phone number, so the form is never left completely open.
SIGNUP_RATE_LIMIT=10
SIGNUP_RATE_LIMIT_WINDOW_S=60
# Optional shared secret for the Tally webhook adapter. Leave blank to disable.
TALLY_SIGNING_SECRET=

# ---- Worker --------------------------------------------------------------
WORKER_POLL_INTERVAL_S=2
WORKER_BATCH_SIZE=5
# Attempts per step before the run fails and its resources are released.
PROVISIONING_MAX_ATTEMPTS=5
# Backoff ladder in seconds; the last value repeats.
PROVISIONING_BACKOFF_S=5,30,120,600
# A step RUNNING longer than this was orphaned by a crash and is retried.
PROVISIONING_STEP_TIMEOUT_S=300
CALL_SUMMARY_MAX_ATTEMPTS=3

# ---- Logging -------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# json (machine-readable, use everywhere non-local) | console (human-readable)
LOG_FORMAT=console

# ---- Database ------------------------------------------------------------
# Consumed from Module 2 onward. Async driver URL.
# Local (docker compose up -d db). Port 55432 - see POSTGRES_PORT below:
DATABASE_URL=postgresql+asyncpg://receptionist:receptionist@localhost:55432/receptionist
# Hosted alternative (Neon / Supabase) — note the required sslmode:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require

# ---- Local Postgres container (docker-compose.yml only) ------------------
POSTGRES_USER=receptionist
POSTGRES_PASSWORD=receptionist
POSTGRES_DB=receptionist
# 55432, not 5432: a native PostgreSQL install often already holds 5432 (and
# 5433 if it runs two clusters). The clash is silent - Docker still reports the
# port as published, but connections reach the other server and fail with a
# confusing "password authentication failed" error. Pick any free port here.
POSTGRES_PORT=55432

# ---- Providers -----------------------------------------------------------
# Which implementation to use. DRY_RUN=true FORCES `fake` for twilio,
# elevenlabs and email regardless of what is set here, so a dry run can never
# spend money. The LLM honours its own setting, because running a dry run
# against a real model is often exactly what you want.
#   fake | anthropic | openai | groq
LLM_PROVIDER=fake
#   fake | twilio
TWILIO_PROVIDER=fake
#   fake | elevenlabs
ELEVENLABS_PROVIDER=fake
#   fake | resend | sendgrid
EMAIL_PROVIDER=fake
# Applies to every outbound provider HTTP call.
PROVIDER_TIMEOUT_S=30

# ---- LLM -----------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Groq serves an OpenAI-compatible API, so it reuses the same adapter shape.
# Added for POC testing while an OpenAI key is unavailable; switching back is
# LLM_PROVIDER alone, with no code change.
GROQ_API_KEY=
# The /openai/v1 suffix is part of the URL: the adapter posts to
# /chat/completions relative to it.
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
# The model ids below are Anthropic's, because `anthropic` is the reference
# real provider. Every other vendor has its own catalogue, so LLM_PROVIDER=groq
# refuses to start until both are set to Groq ids -- a wrong id would otherwise
# surface as a 404 midway through provisioning instead of at boot.
# Groq's current list: https://console.groq.com/docs/models
# Config generation is once per tenant and quality-critical -> strong model.
LLM_CONFIG_MODEL=claude-opus-5
# Summarization is per call and easy -> small, fast model.
LLM_SUMMARY_MODEL=claude-haiku-4-5-20251001
LLM_MAX_TOKENS=4096
# 0.0 so the same form produces the same configuration.
LLM_TEMPERATURE=0.0

# ---- Twilio --------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_BASE_URL=https://api.twilio.com

# ---- ElevenLabs ----------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io
# Shared secret for the post-call webhook. Without it, deliveries are recorded
# but flagged unverified, and are refused outright in staging/production.
ELEVENLABS_WEBHOOK_SECRET=
# Greeting style -> voice. Deterministic: an LLM never chooses a voice.
ELEVENLABS_VOICE_MAP=professional:21m00Tcm4TlvDq8ikWAM,friendly:EXAVITQu4vr4xnSDxMaL,formal:onwK4e9ZLuTAKqWW03F9
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ---- Email ---------------------------------------------------------------
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM="AI Receptionist <onboarding@example.com>"
RESEND_API_BASE_URL=https://api.resend.com
SENDGRID_API_BASE_URL=https://api.sendgrid.com

# ---- Admin ---------------------------------------------------------------
# Shared secret for /api/v1/admin/*. Not an auth system - just enough that the
# retry and abandon actions are not open to the internet. When unset, the admin
# routes are open in local/test and REFUSED in staging/production.
ADMIN_API_KEY=

# ---- Public URLs ---------------------------------------------------------
# Used in notification emails so the recipient can reach their status page.
PUBLIC_APP_URL=http://localhost:3000
# The externally visible base URL of THIS API. Twilio signs the public URL it
# called, so behind a tunnel or proxy (ngrok, a load balancer) the URL this
# process sees is not the one that was signed and every signature check fails.
# Leave blank when nothing sits in front of the API.
#   PUBLIC_API_URL=https://abc123.ngrok.app
PUBLIC_API_URL=

# ---- Orchestration -------------------------------------------------------
# state_machine = the POC polling worker. temporal = production workflows.
# Both exist so Temporal can be proven against the same suite before the state
# machine is retired. Adding Temporal config does not, by itself, switch this.
ORCHESTRATOR=temporal
# per_tenant = one ElevenLabs agent per customer (POC shape).
# shared_vertical = ~5 agents, one per business type, with dynamic variables.
DEFAULT_AGENT_MODE=per_tenant

# ---- Redis ---------------------------------------------------------------
# Cache, locks, rate limiting, webhook dedupe. NEVER the source of truth:
# every read here has a PostgreSQL fallback, and losing Redis must degrade
# latency, not correctness. Set REDIS_ENABLED=false to force every fallback
# path -- that is how the "Redis is down" test variant runs.
REDIS_URL=redis://localhost:56379/0
REDIS_ENABLED=false
# Deliberately short: Redis sits on the audible call path, where waiting on a
# slow cache is worse than missing it and reading PostgreSQL.
REDIS_SOCKET_TIMEOUT_S=0.25
REDIS_CONNECT_TIMEOUT_S=0.25
REDIS_NUMBER_LOOKUP_TTL_S=300
REDIS_CONFIG_CACHE_TTL_S=600
REDIS_WEBHOOK_DEDUPE_TTL_S=86400
REDIS_PROVISION_LOCK_TTL_S=300

# ---- Temporal ------------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=ai-receptionist
TEMPORAL_WORKFLOW_TIMEOUT_S=3600
TEMPORAL_ACTIVITY_TIMEOUT_S=120
# Temporal Cloud uses mTLS; the local server uses neither. Both paths must be
# set together or startup fails -- a certificate without its key produces an
# error that names neither.
TEMPORAL_TLS_ENABLED=false
TEMPORAL_CLIENT_CERT_PATH=
TEMPORAL_CLIENT_KEY_PATH=

# ---- Object storage ------------------------------------------------------
# MinIO locally, S3 in AWS -- the same API behind one interface, so the move is
# an endpoint change rather than a code change.
#   fake | s3
OBJECT_STORAGE_PROVIDER=fake
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ai-receptionist
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO needs path-style addressing; real S3 prefers virtual-host style.
S3_USE_PATH_STYLE=true

# ---- Billing -------------------------------------------------------------
#   fake | stripe
PAYMENT_PROVIDER=fake
# Use a sk_test_ key. DRY_RUN=true forces the fake regardless.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# THE MONEY GATE. When true, provisioning refuses to buy a number unless the
# tenant holds an active subscription or a granted trial. The POC bought a real
# number on every anonymous form submit; this is that leak, closed. Defaults to
# ON and is refused outright in staging/production if switched off.
BILLING_GATE_ENABLED=true
# Days of trial granted at signup. 0 means a card is required before any
# number is bought -- provisioning parks in BILLING_BLOCKED until checkout.
TRIAL_DAYS=14
TRIAL_INCLUDED_MINUTES=60
# How often a run parked on billing re-checks on its own. The Stripe webhook
# un-parks it immediately; this is the fallback for a webhook that is never
# delivered, so a paying customer is never stranded by a missed delivery.
BILLING_RECHECK_INTERVAL_S=300
# Stripe price id -> plan, e.g. "price_abc:pro,price_def:enterprise".
# Configured, not inferred: price ids are account-specific and differ
# between test and live mode. An unmapped price leaves the plan unchanged
# rather than silently downgrading a paying customer.
STRIPE_PRICE_PLANS=

# ---- Authentication ------------------------------------------------------
# Signs session cookies and magic-link tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required, and >=32 chars, in staging/production.
AUTH_SECRET_KEY=
SESSION_COOKIE_NAME=ai_receptionist_session
SESSION_TTL_S=1209600
# Short: a magic link is a bearer credential sitting in an inbox.
MAGIC_LINK_TTL_S=900
# false only for plain-HTTP local development. Refused in staging/production.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT=5
LOGIN_RATE_LIMIT_WINDOW_S=300

# ---- Observability -------------------------------------------------------
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ai-receptionist-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# 1.0 locally so nothing is missed; lower it where volume is real.
OTEL_TRACES_SAMPLE_RATIO=1.0

# ---- SMTP (local Mailpit) ------------------------------------------------
# Mailpit accepts everything on 1025 and delivers nothing. Web UI on :8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false

# ---- Data retention ------------------------------------------------------
# Floor, in days. Per-plan overrides live in the database.
TRANSCRIPT_RETENTION_DAYS=90
RECORDING_RETENTION_DAYS=30

# ---- Local infrastructure ports (docker-compose.yml only) ----------------
# Non-default on purpose: a native Postgres or Redis already holding the
# standard port fails confusingly -- Docker still reports the port as
# published, but connections reach the other server.
REDIS_PORT=56379
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
API_PORT=8000
FRONTEND_PORT=3000

# ---- Frontend (frontend/.env.local) --------------------------------------
# NEXT_PUBLIC_ variables are compiled into the browser bundle and are public by
# definition. Never put a provider key in one.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Optional. Where "Talk to us" and support links point. When unset, those links
# go to the contact page instead of to an address nobody reads.
NEXT_PUBLIC_SUPPORT_EMAIL=

# ---- Telephony: the production call path (M6) ----------------------------
# elevenlabs_native -- the POC path. The number is imported into ElevenLabs and
#                      the vendor owns routing end to end. Simple, but we see
#                      nothing until the post-call webhook and have no fallback.
# twiml_stream      -- the production path. Twilio posts to /voice/inbound, we
#                      decide, and we hand the media stream to the vendor. We
#                      own routing, we can answer with a voicemail when the
#                      vendor is down, and every call is recorded on arrival.
# Defaults to the POC path so existing tenants are unaffected until migrated.
CALL_PATH=elevenlabs_native
ELEVENLABS_STREAM_URL=wss://api.elevenlabs.io/v1/convai/conversation
TWILIO_FALLBACK_VOICE=Polly.Joanna
VOICEMAIL_MAX_LENGTH_S=120
# Recording consent is jurisdictional. Where it is required this must be on;
# the announcement is injected into the greeting rather than left to the prompt.
RECORDING_CONSENT_ANNOUNCEMENT=false

# ---- Shared vertical agents (M7) -----------------------------------------
# "salon:agent_a,legal:agent_b,generic:agent_z". Configured, never discovered:
# agent ids are account-specific, exactly like Stripe price ids. Nothing in the
# application creates a shared agent -- two agents serving one vertical is a
# split-brain where half the customers get a stale prompt.
# Leave blank to keep every tenant on its own dedicated agent.
SHARED_AGENT_IDS=

# ---- Webhook security (M9) -----------------------------------------------
# Production-like environments always require a valid signature; this can only
# raise the bar in local and test, never lower it in staging or production.
# A signature that is *present and wrong* is refused everywhere regardless.
REQUIRE_WEBHOOK_SIGNATURE=false
# How old a signed delivery may be before it is refused as a replay.
WEBHOOK_TOLERANCE_S=1800

# ---- Vendor circuit breakers (M17) ---------------------------------------
# Consecutive failures before a vendor is treated as down, and how long the
# circuit stays open before one probe is allowed through. Per process on
# purpose: a shared breaker would let a cache outage open every circuit at once.
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_S=30

# ---- Background maintenance (M11, M12) -----------------------------------
# How often the worker runs the retention sweep and rebuilds usage rollups.
# Both are idempotent catch-up jobs, so a missed tick costs nothing.
MAINTENANCE_INTERVAL_S=3600
