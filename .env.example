# =============================================================================
# AI Receptionist — environment template
#
# Copy to `.env` and fill in. NEVER commit `.env`.
#   cp .env.example .env
#
# Only the variables that Module 1 actually reads are listed. Vendor
# credentials (Twilio / ElevenLabs / LLM / email) are added by later modules.
# =============================================================================

# ---- Application ---------------------------------------------------------
APP_NAME="AI Receptionist API"
# local | test | development | staging | production
ENVIRONMENT=local
DEBUG=true

# ---- Safety --------------------------------------------------------------
# When true, no external side effect that costs money or mutates a vendor
# account may be performed. Defaults to true and must be flipped explicitly.
# See docs/00_DECISIONS.md section 7.1 (money leak).
DRY_RUN=true

# ---- HTTP ----------------------------------------------------------------
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
CORRELATION_ID_HEADER=X-Correlation-ID

# ---- Signup --------------------------------------------------------------
# Per-IP signups allowed in the window. Every accepted signup eventually spends
# money on a phone number, so the form is never left completely open.
SIGNUP_RATE_LIMIT=10
SIGNUP_RATE_LIMIT_WINDOW_S=60
# Optional shared secret for the Tally webhook adapter. Leave blank to disable.
TALLY_SIGNING_SECRET=

# ---- Worker --------------------------------------------------------------
WORKER_POLL_INTERVAL_S=2
WORKER_BATCH_SIZE=5
# Attempts per step before the run fails and its resources are released.
PROVISIONING_MAX_ATTEMPTS=5
# Backoff ladder in seconds; the last value repeats.
PROVISIONING_BACKOFF_S=5,30,120,600
# A step RUNNING longer than this was orphaned by a crash and is retried.
PROVISIONING_STEP_TIMEOUT_S=300
CALL_SUMMARY_MAX_ATTEMPTS=3

# ---- Logging -------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# json (machine-readable, use everywhere non-local) | console (human-readable)
LOG_FORMAT=console

# ---- Database ------------------------------------------------------------
# Consumed from Module 2 onward. Async driver URL.
# Local (docker compose up -d db). Port 55432 - see POSTGRES_PORT below:
DATABASE_URL=postgresql+asyncpg://receptionist:receptionist@localhost:55432/receptionist
# Hosted alternative (Neon / Supabase) — note the required sslmode:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require

# ---- Local Postgres container (docker-compose.yml only) ------------------
POSTGRES_USER=receptionist
POSTGRES_PASSWORD=receptionist
POSTGRES_DB=receptionist
# 55432, not 5432: a native PostgreSQL install often already holds 5432 (and
# 5433 if it runs two clusters). The clash is silent - Docker still reports the
# port as published, but connections reach the other server and fail with a
# confusing "password authentication failed" error. Pick any free port here.
POSTGRES_PORT=55432

# ---- Providers -----------------------------------------------------------
# Which implementation to use. DRY_RUN=true FORCES `fake` for twilio,
# elevenlabs and email regardless of what is set here, so a dry run can never
# spend money. The LLM honours its own setting, because running a dry run
# against a real model is often exactly what you want.
#   fake | anthropic | openai
LLM_PROVIDER=fake
#   fake | twilio
TWILIO_PROVIDER=fake
#   fake | elevenlabs
ELEVENLABS_PROVIDER=fake
#   fake | resend | sendgrid
EMAIL_PROVIDER=fake
# Applies to every outbound provider HTTP call.
PROVIDER_TIMEOUT_S=30

# ---- LLM -----------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Config generation is once per tenant and quality-critical -> strong model.
LLM_CONFIG_MODEL=claude-opus-5
# Summarization is per call and easy -> small, fast model.
LLM_SUMMARY_MODEL=claude-haiku-4-5-20251001
LLM_MAX_TOKENS=4096
# 0.0 so the same form produces the same configuration.
LLM_TEMPERATURE=0.0

# ---- Twilio --------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_BASE_URL=https://api.twilio.com

# ---- ElevenLabs ----------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_API_BASE_URL=https://api.elevenlabs.io
# Shared secret for the post-call webhook. Without it, deliveries are recorded
# but flagged unverified, and are refused outright in staging/production.
ELEVENLABS_WEBHOOK_SECRET=
# Greeting style -> voice. Deterministic: an LLM never chooses a voice.
ELEVENLABS_VOICE_MAP=professional:21m00Tcm4TlvDq8ikWAM,friendly:EXAVITQu4vr4xnSDxMaL,formal:onwK4e9ZLuTAKqWW03F9
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ---- Email ---------------------------------------------------------------
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM="AI Receptionist <onboarding@example.com>"
RESEND_API_BASE_URL=https://api.resend.com
SENDGRID_API_BASE_URL=https://api.sendgrid.com

# ---- Admin ---------------------------------------------------------------
# Shared secret for /api/v1/admin/*. Not an auth system - just enough that the
# retry and abandon actions are not open to the internet. When unset, the admin
# routes are open in local/test and REFUSED in staging/production.
ADMIN_API_KEY=

# ---- Public URLs ---------------------------------------------------------
# Used in notification emails so the recipient can reach their status page.
PUBLIC_APP_URL=http://localhost:3000
# The externally visible base URL of THIS API. Twilio signs the public URL it
# called, so behind a tunnel or proxy (ngrok, a load balancer) the URL this
# process sees is not the one that was signed and every signature check fails.
# Leave blank when nothing sits in front of the API.
#   PUBLIC_API_URL=https://abc123.ngrok.app
PUBLIC_API_URL=

# ---- Frontend (frontend/.env.local) --------------------------------------
# NEXT_PUBLIC_ variables are compiled into the browser bundle and are public by
# definition. Never put a provider key in one.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
